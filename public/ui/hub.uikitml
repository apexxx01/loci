<!--
  Loci hub: the one panel in the room. Sections are toggled from HubSystem by
  element id; every id below is addressed in src/xr/hub-system.ts.
-->
<style>
  .root { flex-direction: column; width: 460px; padding: 0px; }
  .head { flex-direction: column; gap: 4px; padding-top: 24px; padding-left: 26px; padding-right: 26px; padding-bottom: 12px; }
  .eyebrow { color: #7c5cff; font-size: 11.5px; font-weight: 700; letter-spacing: 2.2px; }
  .eyebrow:dark { color: #b9a6ff; }
  .title { color: #121216; font-size: 34px; font-weight: 700; line-height: 39px; }
  .title:dark { color: #f6f4ff; }
  .tag { color: #4a4a55; font-size: 15.5px; line-height: 21px; }
  .tag:dark { color: #c9c6d8; }
  .section { flex-direction: column; gap: 9px; padding-left: 26px; padding-right: 26px; padding-bottom: 24px; }
  .label { color: #4a4a55; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; margin-top: 8px; }
  .label:dark { color: #a7a3bd; }
  .row { flex-direction: row; gap: 9px; }
  .btn { flex-grow: 1; justify-content: flex-start; }
  .stat { flex-direction: column; flex-grow: 1; padding: 10px; border-radius: 12px; background-color: #ecebf5; }
  .stat:dark { background-color: #23222e; }
  .stat-num { color: #121216; font-size: 26px; font-weight: 700; }
  .stat-num:dark { color: #ffffff; }
  .stat-cap { color: #5d5a6e; font-size: 10.5px; }
  .stat-cap:dark { color: #a7a3bd; }
  .status { color: #3d3a4c; font-size: 13.5px; line-height: 19px; }
  .status:dark { color: #d9d5ee; }
  .hint { color: #5d5a6e; font-size: 12px; line-height: 17px; }
  .hint:dark { color: #a7a3bd; }
</style>
<Panel id="hub-root" class="root">
  <div class="head">
    <div class="eyebrow">LOCI</div>
    <div class="title">Your room remembers.</div>
    <div id="hub-tagline" class="tag">Pick something to learn. I will place it on the furniture around you.</div>
  </div>

  <div id="section-decks" class="section">
    <div class="label">START A PALACE</div>
    <Button id="deck-planets" class="btn">
      <ButtonIcon><Orbit></Orbit></ButtonIcon>
      <ButtonLabel>The Planets, in order</ButtonLabel>
    </Button>
    <Button id="deck-elements" class="btn">
      <ButtonIcon><FlaskConical></FlaskConical></ButtonIcon>
      <ButtonLabel>First 10 Elements</ButtonLabel>
    </Button>
    <Button id="deck-spanish" class="btn">
      <ButtonIcon><Languages></Languages></ButtonIcon>
      <ButtonLabel>Spanish Survival Phrases</ButtonLabel>
    </Button>
    <Button id="deck-phone" class="btn">
      <ButtonIcon><NotebookPen></NotebookPen></ButtonIcon>
      <ButtonLabel id="deck-phone-label">Use my own notes (opens the page)</ButtonLabel>
    </Button>
  </div>

  <div id="section-palace" class="section" style="display: none">
    <div id="palace-title" class="label">YOUR PALACE</div>
    <div class="row">
      <div class="stat">
        <div id="stat-due" class="stat-num">0</div>
        <div class="stat-cap">due now</div>
      </div>
      <div class="stat">
        <div id="stat-mastery" class="stat-num">0%</div>
        <div class="stat-cap">mastered</div>
      </div>
      <div class="stat">
        <div id="stat-streak" class="stat-num">0</div>
        <div class="stat-cap">day streak</div>
      </div>
    </div>
    <div id="palace-howto" class="hint">Look at a glowing memory and recall it. Pinch to peek. Grab it and raise it UP if you remembered, lower it DOWN if you did not.</div>
    <div class="row">
      <Button id="btn-refit" class="btn">
        <ButtonIcon><RefreshCw></RefreshCw></ButtonIcon>
        <ButtonLabel>Re-fit to room</ButtonLabel>
      </Button>
      <Button id="btn-new" class="btn">
        <ButtonIcon><Plus></Plus></ButtonIcon>
        <ButtonLabel>New palace</ButtonLabel>
      </Button>
    </div>
  </div>

  <div id="section-access" class="section">
    <div class="label">COMFORT AND ACCESS</div>
    <div class="row">
      <Button id="acc-dwell" class="btn" variant="secondary">
        <ButtonIcon><Eye></Eye></ButtonIcon>
        <ButtonLabel id="acc-dwell-label">Look to select: off</ButtonLabel>
      </Button>
      <Button id="acc-contrast" class="btn" variant="secondary">
        <ButtonIcon><Contrast></Contrast></ButtonIcon>
        <ButtonLabel id="acc-contrast-label">High contrast: off</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="acc-large" class="btn" variant="secondary">
        <ButtonIcon><ZoomIn></ZoomIn></ButtonIcon>
        <ButtonLabel id="acc-large-label">Larger tiles: off</ButtonLabel>
      </Button>
      <Button id="acc-calm" class="btn" variant="secondary">
        <ButtonIcon><Wind></Wind></ButtonIcon>
        <ButtonLabel id="acc-calm-label">Calm motion: off</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="acc-sound" class="btn" variant="secondary">
        <ButtonIcon><Volume2></Volume2></ButtonIcon>
        <ButtonLabel id="acc-sound-label">Sound: on</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="section">
    <div id="hub-status" class="status">Ready.</div>
  </div>
</Panel>

<!--
  Loci hub: the one panel in the room. Sections are toggled from HubSystem by
  element id; every id below is addressed in src/xr/hub-system.ts.
-->
<style>
  .root { flex-direction: column; width: 480px; padding: 0px; background-color: #120e2a; border-radius: 30px; border-width: 2px; border-color: #5a4630; }
  .big { height: 64px; }
  .group { flex-direction: column; gap: 8px; }
  .key { flex-grow: 1; flex-basis: 0; min-width: 0px; height: 46px; padding-left: 0px; padding-right: 0px; justify-content: center; background-color: #241b4a; }
  .key:dark { background-color: #241b4a; }
  .keys { flex-direction: row; gap: 4px; width: 100%; }
  .chip { flex-grow: 1; flex-basis: 0; min-width: 0px; height: 44px; justify-content: center; background-color: #2e2358; }
  .chip:dark { background-color: #2e2358; }
  .space { flex-grow: 2; justify-content: center; }
  .go { background-color: #9a6418; }
  .go:dark { background-color: #9a6418; }
  .field { padding: 14px; border-radius: 16px; background-color: #0b0820; border-width: 2px; border-color: #6b5434; min-height: 64px; }
  .field-text { color: #fff4e6; font-size: 20px; line-height: 26px; }
  .lbl { color: #fff4e6; }
  .lbl:dark { color: #fff4e6; }
  .skin { flex-direction: column; width: 100%; background-color: #120e2a; border-radius: 30px; border-width: 2px; border-color: #6b5434; }
  .root:dark { background-color: #120e2a; border-color: #5a4630; }
  .head { flex-direction: column; gap: 4px; padding-top: 24px; padding-left: 26px; padding-right: 26px; padding-bottom: 12px; }
  .eyebrow { color: #ffcf7a; font-size: 11.5px; font-weight: 700; letter-spacing: 2.2px; }
  .eyebrow:dark { color: #ffcf7a; }
  .title { color: #fff4e6; font-size: 31px; font-weight: 600; line-height: 37px; }
  .title:dark { color: #fff4e6; }
  .tag { color: #d9d2f2; font-size: 15.5px; line-height: 21px; }
  .tag:dark { color: #d9d2f2; }
  .section { flex-direction: column; gap: 9px; padding-left: 26px; padding-right: 26px; padding-bottom: 24px; }
  .label { color: #b9b0dc; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; margin-top: 8px; }
  .label:dark { color: #b9b0dc; }
  .row { flex-direction: row; gap: 9px; }
  .btn { flex-grow: 1; flex-basis: 0; justify-content: flex-start; background-color: #241b4a; }
  .btn:dark { background-color: #241b4a; }
  .stat { flex-direction: column; flex-grow: 1; padding: 10px; border-radius: 14px; background-color: #221a45; }
  .stat:dark { background-color: #221a45; }
  .stat-num { color: #ffcf7a; font-size: 26px; font-weight: 700; }
  .stat-num:dark { color: #ffcf7a; }
  .stat-cap { color: #b9b0dc; font-size: 10.5px; }
  .stat-cap:dark { color: #b9b0dc; }
  .status { color: #efe9ff; font-size: 13.5px; line-height: 19px; }
  .status:dark { color: #efe9ff; }
  .hint { color: #b9b0dc; font-size: 12px; line-height: 17px; }
  .hint:dark { color: #b9b0dc; }
</style>
<Panel id="hub-root" class="root">
<div class="skin">
  <div class="head">
    <div class="eyebrow">LOCI</div>
    <div id="hub-heading" class="title">What do you want to understand?</div>
    <div id="hub-tagline" class="tag">Ask, and its stages will land on the furniture around you.</div>
  </div>

  <div id="section-decks" class="section">
    <Button id="btn-ask" class="btn big">
      <ButtonIcon><Sparkles></Sparkles></ButtonIcon>
      <ButtonLabel class="lbl">Ask about anything</ButtonLabel>
    </Button>
    <div id="recent-block" class="group">
      <div class="label">PICK UP WHERE YOU LEFT OFF</div>
      <Button id="recent-0" class="btn"><ButtonIcon><History></History></ButtonIcon><ButtonLabel class="lbl" id="recent-0-label">Recent</ButtonLabel></Button>
      <Button id="recent-1" class="btn"><ButtonIcon><History></History></ButtonIcon><ButtonLabel class="lbl" id="recent-1-label">Recent</ButtonLabel></Button>
      <Button id="recent-2" class="btn"><ButtonIcon><History></History></ButtonIcon><ButtonLabel class="lbl" id="recent-2-label">Recent</ButtonLabel></Button>
    </div>
    <div class="row">
      <Button id="btn-browse" class="btn">
        <ButtonIcon><BookOpen></BookOpen></ButtonIcon>
        <ButtonLabel class="lbl" id="btn-browse-label">Ready-made walks</ButtonLabel>
      </Button>
      <Button id="btn-open" class="btn">
        <ButtonIcon><Library></Library></ButtonIcon>
        <ButtonLabel class="lbl" id="btn-open-label">Saved palaces</ButtonLabel>
      </Button>
    </div>
    <div id="browse-block" class="group">
      <div class="row">
        <Button id="concept-heart" class="btn"><ButtonIcon><Heart></Heart></ButtonIcon><ButtonLabel class="lbl">How your heart pumps</ButtonLabel></Button>
        <Button id="concept-plants" class="btn"><ButtonIcon><Leaf></Leaf></ButtonIcon><ButtonLabel class="lbl">How plants make food</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="concept-seasons" class="btn"><ButtonIcon><Sun></Sun></ButtonIcon><ButtonLabel class="lbl">Why we have seasons</ButtonLabel></Button>
        <Button id="concept-vaccine" class="btn"><ButtonIcon><ShieldCheck></ShieldCheck></ButtonIcon><ButtonLabel class="lbl">How vaccines train you</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="concept-water" class="btn"><ButtonIcon><Droplets></Droplets></ButtonIcon><ButtonLabel class="lbl">The water cycle</ButtonLabel></Button>
        <Button id="concept-web" class="btn"><ButtonIcon><Globe></Globe></ButtonIcon><ButtonLabel class="lbl">How a web page arrives</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="concept-pr" class="btn"><ButtonIcon><GitPullRequest></GitPullRequest></ButtonIcon><ButtonLabel class="lbl">How code gets merged</ButtonLabel></Button>
        <Button id="deck-planets" class="btn"><ButtonIcon><Orbit></Orbit></ButtonIcon><ButtonLabel class="lbl">A quick list: the planets</ButtonLabel></Button>
      </div>
      <div class="row">
        <Button id="deck-phone" class="btn"><ButtonIcon><FileText></FileText></ButtonIcon><ButtonLabel class="lbl" id="deck-phone-label">Paste notes on a screen</ButtonLabel></Button>
      </div>
    </div>
  </div>

  <div id="section-ask" class="section">
    <div class="field"><div id="ask-text" class="field-text">Type with a pinch on each key</div></div>
    <div class="row">
      <Button id="pre-how" class="chip"><ButtonLabel class="lbl" id="pre-how-label">How does</ButtonLabel></Button>
      <Button id="pre-why" class="chip"><ButtonLabel class="lbl" id="pre-why-label">Why do</ButtonLabel></Button>
    </div>
    <div class="row">
      <Button id="pre-what" class="chip"><ButtonLabel class="lbl" id="pre-what-label">What is</ButtonLabel></Button>
      <Button id="pre-explain" class="chip"><ButtonLabel class="lbl" id="pre-explain-label">Explain</ButtonLabel></Button>
    </div>
    <div class="keys"><Button id="key-q" class="key"><ButtonLabel class="lbl">Q</ButtonLabel></Button><Button id="key-w" class="key"><ButtonLabel class="lbl">W</ButtonLabel></Button><Button id="key-e" class="key"><ButtonLabel class="lbl">E</ButtonLabel></Button><Button id="key-r" class="key"><ButtonLabel class="lbl">R</ButtonLabel></Button><Button id="key-t" class="key"><ButtonLabel class="lbl">T</ButtonLabel></Button><Button id="key-y" class="key"><ButtonLabel class="lbl">Y</ButtonLabel></Button><Button id="key-u" class="key"><ButtonLabel class="lbl">U</ButtonLabel></Button><Button id="key-i" class="key"><ButtonLabel class="lbl">I</ButtonLabel></Button><Button id="key-o" class="key"><ButtonLabel class="lbl">O</ButtonLabel></Button><Button id="key-p" class="key"><ButtonLabel class="lbl">P</ButtonLabel></Button></div>
    <div class="keys"><Button id="key-a" class="key"><ButtonLabel class="lbl">A</ButtonLabel></Button><Button id="key-s" class="key"><ButtonLabel class="lbl">S</ButtonLabel></Button><Button id="key-d" class="key"><ButtonLabel class="lbl">D</ButtonLabel></Button><Button id="key-f" class="key"><ButtonLabel class="lbl">F</ButtonLabel></Button><Button id="key-g" class="key"><ButtonLabel class="lbl">G</ButtonLabel></Button><Button id="key-h" class="key"><ButtonLabel class="lbl">H</ButtonLabel></Button><Button id="key-j" class="key"><ButtonLabel class="lbl">J</ButtonLabel></Button><Button id="key-k" class="key"><ButtonLabel class="lbl">K</ButtonLabel></Button><Button id="key-l" class="key"><ButtonLabel class="lbl">L</ButtonLabel></Button></div>
    <div class="keys"><Button id="key-z" class="key"><ButtonLabel class="lbl">Z</ButtonLabel></Button><Button id="key-x" class="key"><ButtonLabel class="lbl">X</ButtonLabel></Button><Button id="key-c" class="key"><ButtonLabel class="lbl">C</ButtonLabel></Button><Button id="key-v" class="key"><ButtonLabel class="lbl">V</ButtonLabel></Button><Button id="key-b" class="key"><ButtonLabel class="lbl">B</ButtonLabel></Button><Button id="key-n" class="key"><ButtonLabel class="lbl">N</ButtonLabel></Button><Button id="key-m" class="key"><ButtonLabel class="lbl">M</ButtonLabel></Button><Button id="key-q-mark" class="key"><ButtonLabel class="lbl">?</ButtonLabel></Button></div>
    <div class="row">
      <Button id="key-back" class="btn"><ButtonIcon><Delete></Delete></ButtonIcon><ButtonLabel class="lbl">Delete</ButtonLabel></Button>
      <Button id="key-space" class="btn space"><ButtonLabel class="lbl">Space</ButtonLabel></Button>
    </div>
    <div class="row">
      <Button id="ask-cancel" class="btn"><ButtonIcon><X></X></ButtonIcon><ButtonLabel class="lbl">Back</ButtonLabel></Button>
      <Button id="ask-go" class="btn go"><ButtonIcon><Sparkles></Sparkles></ButtonIcon><ButtonLabel class="lbl" id="ask-go-label">Teach me</ButtonLabel></Button>
    </div>
  </div>

  <div id="section-palace" class="section" style="display: none">
    <div id="palace-title" class="label">YOUR PALACE</div>
    <div id="stats-row" class="row">
      <div class="stat">
        <div id="stat-due" class="stat-num">0</div>
        <div class="stat-cap">due now</div>
      </div>
      <div class="stat">
        <div id="stat-mastery" class="stat-num">0%</div>
        <div class="stat-cap">mastered</div>
      </div>
      <div class="stat">
        <div id="stat-streak" class="stat-num">0</div>
        <div class="stat-cap">day streak</div>
      </div>
    </div>
    <div id="palace-howto" class="hint">Pinch a memory to turn it over.</div>
    <Button id="btn-chain" class="btn">
      <ButtonIcon><Link></Link></ButtonIcon>
      <ButtonLabel class="lbl" id="btn-chain-label">Rebuild the chain</ButtonLabel>
    </Button>
    <div class="row">
      <Button id="btn-refit" class="btn">
        <ButtonIcon><RefreshCw></RefreshCw></ButtonIcon>
        <ButtonLabel class="lbl">Re-fit to room</ButtonLabel>
      </Button>
      <Button id="btn-new" class="btn">
        <ButtonIcon><Plus></Plus></ButtonIcon>
        <ButtonLabel class="lbl">New palace</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="btn-switch" class="btn">
        <ButtonIcon><Library></Library></ButtonIcon>
        <ButtonLabel class="lbl" id="btn-switch-label">Switch palace</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="section">
    <Button id="btn-access" class="btn">
      <ButtonIcon><Accessibility></Accessibility></ButtonIcon>
      <ButtonLabel class="lbl" id="btn-access-label">Comfort and access</ButtonLabel>
    </Button>
  </div>
  <div id="section-access" class="section" style="display: none">
    <div class="row">
      <Button id="acc-dwell" class="btn">
        <ButtonIcon><Eye></Eye></ButtonIcon>
        <ButtonLabel class="lbl" id="acc-dwell-label">Look to select: off</ButtonLabel>
      </Button>
      <Button id="acc-contrast" class="btn">
        <ButtonIcon><Contrast></Contrast></ButtonIcon>
        <ButtonLabel class="lbl" id="acc-contrast-label">High contrast: off</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="acc-large" class="btn">
        <ButtonIcon><ZoomIn></ZoomIn></ButtonIcon>
        <ButtonLabel class="lbl" id="acc-large-label">Larger tiles: off</ButtonLabel>
      </Button>
      <Button id="acc-calm" class="btn">
        <ButtonIcon><Wind></Wind></ButtonIcon>
        <ButtonLabel class="lbl" id="acc-calm-label">Calm motion: off</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="acc-speak" class="btn">
        <ButtonIcon><Speech></Speech></ButtonIcon>
        <ButtonLabel class="lbl" id="acc-speak-label">Read aloud: off</ButtonLabel>
      </Button>
      <Button id="acc-sound" class="btn">
        <ButtonIcon><Volume2></Volume2></ButtonIcon>
        <ButtonLabel class="lbl" id="acc-sound-label">Sound: on</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="section">
    <div id="hub-status" class="status">Ready.</div>
  </div>
</div>
</Panel>

<!--
  Loci hub: the one panel in the room. Sections are toggled from HubSystem by
  element id; every id below is addressed in src/xr/hub-system.ts.
-->
<style>
  .root { flex-direction: column; width: 480px; padding: 0px; background-color: #120e2a; border-radius: 30px; }
  .head { flex-direction: column; gap: 4px; padding-top: 24px; padding-left: 26px; padding-right: 26px; padding-bottom: 12px; }
  .eyebrow { color: #ffcf7a; font-size: 11.5px; font-weight: 700; letter-spacing: 2.2px; }
  .eyebrow:dark { color: #ffcf7a; }
  .title { color: #fff4e6; font-size: 31px; font-weight: 600; line-height: 37px; }
  .title:dark { color: #f6f4ff; }
  .tag { color: #d9d2f2; font-size: 15.5px; line-height: 21px; }
  .tag:dark { color: #c9c6d8; }
  .section { flex-direction: column; gap: 9px; padding-left: 26px; padding-right: 26px; padding-bottom: 24px; }
  .label { color: #b9b0dc; font-size: 12px; font-weight: 700; letter-spacing: 1.5px; margin-top: 8px; }
  .label:dark { color: #a7a3bd; }
  .row { flex-direction: row; gap: 9px; }
  .btn { flex-grow: 1; flex-basis: 0; justify-content: flex-start; }
  .stat { flex-direction: column; flex-grow: 1; padding: 10px; border-radius: 14px; background-color: #221a45; }
  .stat:dark { background-color: #23222e; }
  .stat-num { color: #ffcf7a; font-size: 26px; font-weight: 700; }
  .stat-num:dark { color: #ffffff; }
  .stat-cap { color: #b9b0dc; font-size: 10.5px; }
  .stat-cap:dark { color: #a7a3bd; }
  .status { color: #efe9ff; font-size: 13.5px; line-height: 19px; }
  .status:dark { color: #d9d5ee; }
  .hint { color: #b9b0dc; font-size: 12px; line-height: 17px; }
  .hint:dark { color: #a7a3bd; }
</style>
<Panel id="hub-root" class="root">
  <div class="head">
    <div class="eyebrow">LOCI</div>
    <div id="hub-heading" class="title">What do you want to understand?</div>
    <div id="hub-tagline" class="tag">Pinch one. Its stages will land on the furniture around you.</div>
  </div>

  <div id="section-decks" class="section">
    <div class="row">
      <Button id="concept-heart" class="btn">
        <ButtonIcon><Heart></Heart></ButtonIcon>
        <ButtonLabel>How your heart pumps</ButtonLabel>
      </Button>
      <Button id="concept-plants" class="btn">
        <ButtonIcon><Leaf></Leaf></ButtonIcon>
        <ButtonLabel>How plants make food</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="concept-seasons" class="btn">
        <ButtonIcon><Sun></Sun></ButtonIcon>
        <ButtonLabel>Why we have seasons</ButtonLabel>
      </Button>
      <Button id="concept-vaccine" class="btn">
        <ButtonIcon><ShieldCheck></ShieldCheck></ButtonIcon>
        <ButtonLabel>How vaccines train you</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="concept-water" class="btn">
        <ButtonIcon><Droplets></Droplets></ButtonIcon>
        <ButtonLabel>The water cycle</ButtonLabel>
      </Button>
      <Button id="concept-web" class="btn">
        <ButtonIcon><Globe></Globe></ButtonIcon>
        <ButtonLabel>How a web page arrives</ButtonLabel>
      </Button>
    </div>
    <div class="label">OR</div>
    <div class="row">
      <Button id="deck-phone" class="btn" variant="secondary">
        <ButtonIcon><Sparkles></Sparkles></ButtonIcon>
        <ButtonLabel id="deck-phone-label">Anything else</ButtonLabel>
      </Button>
      <Button id="deck-planets" class="btn" variant="secondary">
        <ButtonIcon><Orbit></Orbit></ButtonIcon>
        <ButtonLabel>A quick list</ButtonLabel>
      </Button>
    </div>
    <Button id="btn-open" class="btn" variant="secondary">
      <ButtonIcon><Library></Library></ButtonIcon>
      <ButtonLabel id="btn-open-label">Open a saved palace</ButtonLabel>
    </Button>
  </div>

  <div id="section-palace" class="section" style="display: none">
    <div id="palace-title" class="label">YOUR PALACE</div>
    <div class="row">
      <div class="stat">
        <div id="stat-due" class="stat-num">0</div>
        <div class="stat-cap">due now</div>
      </div>
      <div class="stat">
        <div id="stat-mastery" class="stat-num">0%</div>
        <div class="stat-cap">mastered</div>
      </div>
      <div class="stat">
        <div id="stat-streak" class="stat-num">0</div>
        <div class="stat-cap">day streak</div>
      </div>
    </div>
    <div id="palace-howto" class="hint">Pinch a memory to turn it over.</div>
    <div class="row">
      <Button id="btn-refit" class="btn">
        <ButtonIcon><RefreshCw></RefreshCw></ButtonIcon>
        <ButtonLabel>Re-fit to room</ButtonLabel>
      </Button>
      <Button id="btn-new" class="btn">
        <ButtonIcon><Plus></Plus></ButtonIcon>
        <ButtonLabel>New palace</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="btn-switch" class="btn" variant="secondary">
        <ButtonIcon><Library></Library></ButtonIcon>
        <ButtonLabel id="btn-switch-label">Switch palace</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="section">
    <Button id="btn-access" class="btn" variant="secondary">
      <ButtonIcon><Accessibility></Accessibility></ButtonIcon>
      <ButtonLabel id="btn-access-label">Comfort and access</ButtonLabel>
    </Button>
  </div>
  <div id="section-access" class="section" style="display: none">
    <div class="row">
      <Button id="acc-dwell" class="btn" variant="secondary">
        <ButtonIcon><Eye></Eye></ButtonIcon>
        <ButtonLabel id="acc-dwell-label">Look to select: off</ButtonLabel>
      </Button>
      <Button id="acc-contrast" class="btn" variant="secondary">
        <ButtonIcon><Contrast></Contrast></ButtonIcon>
        <ButtonLabel id="acc-contrast-label">High contrast: off</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="acc-large" class="btn" variant="secondary">
        <ButtonIcon><ZoomIn></ZoomIn></ButtonIcon>
        <ButtonLabel id="acc-large-label">Larger tiles: off</ButtonLabel>
      </Button>
      <Button id="acc-calm" class="btn" variant="secondary">
        <ButtonIcon><Wind></Wind></ButtonIcon>
        <ButtonLabel id="acc-calm-label">Calm motion: off</ButtonLabel>
      </Button>
    </div>
    <div class="row">
      <Button id="acc-speak" class="btn" variant="secondary">
        <ButtonIcon><Speech></Speech></ButtonIcon>
        <ButtonLabel id="acc-speak-label">Read aloud: off</ButtonLabel>
      </Button>
      <Button id="acc-sound" class="btn" variant="secondary">
        <ButtonIcon><Volume2></Volume2></ButtonIcon>
        <ButtonLabel id="acc-sound-label">Sound: on</ButtonLabel>
      </Button>
    </div>
  </div>

  <div class="section">
    <div id="hub-status" class="status">Ready.</div>
  </div>
</Panel>

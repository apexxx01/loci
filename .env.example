# Server-side only (Vercel project settings -> Environment Variables).
GEMINI_API_KEY=
# Optional: override the model used by the Palace Architect.
GEMINI_MODEL=gemini-3.8-flash
# Optional backup: Amazon Nova on AWS Bedrock answers when every Gemini model fails.
# Use an IAM user allowed only bedrock:InvokeModel and InvokeModelWithResponseStream.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
# BEDROCK_FIRST=1   # ask Nova before Gemini
